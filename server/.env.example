NODE_ENV=development
PORT=4000

# Provided by you — MySQL connection string
DATABASE_URL="mysql://user:password@host:3306/sharefinance"

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_RATE_LIMIT_PER_PHONE=3
OTP_REQUEST_RATE_LIMIT_WINDOW_MINUTES=10

# mock | teekrr
NOTIFICATION_PROVIDER=mock
TEEKRR_API_BASE_URL=https://staging-api.teekrr.com
TEEKRR_API_KEY=

# simulated | billplz | toyyibpay | curlec
PAYMENT_GATEWAY_PROVIDER=simulated
PAYMENT_GATEWAY_API_KEY=

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

LOG_LEVEL=info

# Dev-only convenience: when true, the OTP code is echoed in the
# /auth/otp/request response so you can test without WhatsApp configured.
# Never enable in production.
DEBUG_OTP_ECHO=true
